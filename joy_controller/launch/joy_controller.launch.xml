<?xml version="1.0"?>
<!--
Joy Controller launch file
YAML が Single Source of Truth。個別の use_sim_time / debug_mode / joy_device 等の
launch 引数は廃止し、YAML を編集するか config_file:=... で切り替えること。
例外: joy_topic は launcher が /joy <-> /joy_gated を切替えるために使う唯一のインライン override。
YAML 読み込みより後に置くことで launcher からの指定が勝つようにする。
-->
<launch>
    <arg name="dual_stick" default="false" description="Use dual stick differential drive mode" />
    <arg name="config_file"
         default="$(find-pkg-share joy_controller)/config/joy_controller_params.yaml"
         description="Path to the joy_controller configuration YAML" />
    <arg name="dual_stick_config_file"
         default="$(find-pkg-share joy_controller)/config/joy_controller_dual_stick_params.yaml"
         description="Path to the dual stick configuration YAML" />
    <arg name="joy_node_config_file"
         default="$(find-pkg-share joy_controller)/config/joy_node_params.yaml"
         description="Path to the joy_node configuration YAML" />
    <arg name="uart_config_file"
         default="$(find-pkg-share uart_joy_driver)/config/uart_joy_driver_params.yaml"
         description="Path to the UART joy driver configuration YAML" />
    <arg name="web_config_file"
         default="$(find-pkg-share web_joy_driver)/config/web_joy_driver_params.yaml"
         description="Path to the web (smartphone/browser) joy driver configuration YAML" />
    <arg name="controller_type" default="uart" description="Controller type: dualshock, uart, or web" />
    <arg name="joy_topic" default="/joy" description="Joy input topic (override only)" />
    <include file="$(find-pkg-share questix_control_config)/launch/control_profile.launch.py" />

    <!-- Joy node (from joy package) - DualShock mode (also the fallback for unknown types) -->
    <group unless="$(or $(equals '$(var controller_type)' 'uart') $(equals '$(var controller_type)' 'web'))">
        <node pkg="joy" exec="joy_node" name="joy_node" output="screen">
            <param from="$(var joy_node_config_file)" />
            <param from="$(var control_config_file)" />
        </node>
    </group>

    <!-- UART Joy Driver node - UART mode -->
    <group if="$(equals '$(var controller_type)' 'uart')">
        <node pkg="uart_joy_driver" exec="uart_joy_driver_node" name="uart_joy_driver" output="screen">
            <param from="$(var uart_config_file)" />
            <param from="$(var control_config_file)" />
        </node>
    </group>

    <!-- Web Joy Driver node - smartphone/browser mode (Switch2-native indices, same as UART) -->
    <group if="$(equals '$(var controller_type)' 'web')">
        <node pkg="web_joy_driver" exec="web_joy_driver_node" name="web_joy_driver" output="screen">
            <param from="$(var web_config_file)" />
        </node>
    </group>

    <!-- Joy controller node (single stick mode) -->
    <node pkg="joy_controller" exec="joy_controller_node" name="joy_controller" output="screen" unless="$(var dual_stick)">
        <param from="$(var config_file)" />
        <param from="$(var control_config_file)" />
        <param name="joy_topic" value="$(var joy_topic)" />
    </node>

    <!-- Joy controller dual stick node (dual stick mode) -->
    <node pkg="joy_controller" exec="joy_controller_dual_stick_node" name="joy_controller_dual_stick" output="screen" if="$(var dual_stick)">
        <param from="$(var dual_stick_config_file)" />
        <param from="$(var control_config_file)" />
        <param name="joy_topic" value="$(var joy_topic)" />
    </node>
</launch>
