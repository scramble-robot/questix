<?xml version="1.0"?>
<launch>
  <arg name="config_file"
       default="$(find-pkg-share questix_lab_bridge)/config/lab_bridge.yaml"
       description="Parameter file of the QUESTiX LAB live bridge" />

  <!-- Telemetry mirror for the QUESTiX LAB pages. Pages move the robot only while the teacher's
       lesson permission (/lab_permission, from Robot Manager) and /motion_permission allow it. -->
  <node pkg="questix_lab_bridge" exec="lab_bridge_node" name="questix_lab_bridge" output="screen">
    <param from="$(var config_file)" />
  </node>
</launch>
