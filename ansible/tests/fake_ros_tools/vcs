#!/usr/bin/env bash
# Fake vcs for ansible/tests (ros2_build): logs the call and "imports" each repository of the
# --input file as an empty directory under the target, as `vcs import` would clone it.
set -euo pipefail
echo "vcs $*" >>"$FAKE_ROS_LOG"
input=""
target=""
while [ $# -gt 0 ]; do
    case "$1" in
        --input) input="$2"; shift 2 ;;
        import | --skip-existing) shift ;;
        *) target="$1"; shift ;;
    esac
done
awk '/^    [A-Za-z0-9_.-]+:[[:space:]]*$/ { sub(/:.*/, ""); sub(/^ +/, ""); print }' "$input" |
    while read -r name; do
        [ -e "$target/$name" ] || mkdir -p "$target/$name/.git"
    done
