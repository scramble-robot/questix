# {{ ansible_managed }}
# Current access point settings, read by scripts/wifi-ap.sh (wifi_access_point role).
WIFI_AP_STATE={{ wifi_ap_state | quote }}
WIFI_AP_INTERFACE={{ wifi_ap_interface | quote }}
WIFI_AP_SSID={{ wifi_ap_ssid | quote }}
WIFI_AP_PASSWORD={{ wifi_ap_password | quote }}
WIFI_AP_BAND={{ wifi_ap_band | quote }}
WIFI_AP_CHANNEL={{ wifi_ap_channel | quote }}
WIFI_AP_COUNTRY={{ wifi_ap_country | quote }}
WIFI_AP_ADDRESS={{ wifi_ap_address | quote }}
