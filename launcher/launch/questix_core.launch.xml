<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Launch Arguments -->
  <arg name="use_sim_time" default="false" description="Use simulation time"/>
  <arg name="enable_lidar" default="$(env ENABLE_LIDAR false)" description="Enable YDLiDAR"/>
  <arg name="enable_shot" default="$(env ENABLE_SHOT true)" description="Enable Shot component"/>
  <arg name="enable_drive" default="$(env ENABLE_DRIVE true)" description="Enable drive component"/>
  <!-- GPIO5 monitoring is the default for every launch (issue #168). A literal default, never
       $(env ENABLE_GPIO_REF ...): no environment (a sourced launch.env, an export) selects the
       no-GPIO diagnostic; only an explicit enable_gpio_ref:=false on this one launch does. -->
  <arg name="enable_gpio_ref" default="true" description="Enable the GPIO safety path (gpio_reader; the emergency stop reads GPIO5). false: explicit manual diagnostic only, for this launch process"/>
  <!-- The robot's mode, the one argument that says how this launch is wired
       (scripts/robot_manager/modes.py; the robot launcher passes the saved mode):
       lesson      教材: QUESTiX LAB shares the drive (twist_arbiter) and the launcher (the nodes'
                   lab input); the motion permission needs the teacher's vote.
       practice    練習: the controller alone; the motion permission needs no vote.
       competition 大会: gpio_reader also reads GPIO27 (AutoReferee) for the referee's vote, which
                   the motion permission needs. Requires the GPIO safety path.
       The emergency stop (GPIO5) is the same in every mode.
       The actuators are the same in every mode: they obey /emergency_stop and /motion_permission.
       Not read from the environment. -->
  <arg name="robot_mode" default="practice" description="lesson, practice or competition"/>
  <arg name="controller_type" default="$(env CONTROLLER_TYPE dualshock)" description="Controller type: dualshock, uart, or web (smartphone browser)"/>
  <arg name="enable_rviz" default="$(env ENABLE_RVIZ false)" description="Enable RViz visualization"/>
  <!-- Replaced by robot_mode. Declared only so that a launch still passing one is refused below
       instead of silently running another mode (e.g. enable_autoreferee:=true as practice). -->
  <arg name="enable_autoreferee" default="removed" description="Removed: use robot_mode:=competition"/>
  <arg name="require_teacher_permission" default="removed" description="Removed: use robot_mode:=lesson"/>
  <arg name="enable_twist_arbiter" default="removed" description="Removed: robot_mode:=lesson starts twist_arbiter"/>
  <arg name="enable_lab_shoot" default="removed" description="Removed: robot_mode:=lesson enables QUESTiX LAB's launcher input"/>

  <!-- What robot_mode decides; nothing below reads robot_mode itself. -->
  <let name="is_competition" value="$(equals '$(var robot_mode)' 'competition')"/>
  <let name="is_lesson" value="$(equals '$(var robot_mode)' 'lesson')"/>
  <let name="is_known_mode" value="$(or $(var is_competition) $(or $(var is_lesson) $(equals '$(var robot_mode)' 'practice')))"/>
  <!-- "removed" (the default) marks an argument nobody passed; launch XML cannot compare with ''. -->
  <let name="legacy_arguments" value="$(not $(and $(equals '$(var enable_autoreferee)' 'removed') $(and $(equals '$(var require_teacher_permission)' 'removed') $(and $(equals '$(var enable_twist_arbiter)' 'removed') $(equals '$(var enable_lab_shoot)' 'removed')))))"/>
  <let name="competition_without_gpio" value="$(and $(var is_competition) $(not $(var enable_gpio_ref)))"/>
  <let name="invalid_configuration" value="$(or $(not $(var is_known_mode)) $(or $(var competition_without_gpio) $(var legacy_arguments)))"/>

  <!-- Invalid configurations are refused before any child process starts (one place for every
       combination: design/safety_permission_input_refactor.md, section 6.6). -->
  <group if="$(var invalid_configuration)">
    <group unless="$(var is_known_mode)">
      <log message="ERROR: robot_mode must be lesson, practice or competition (got '$(var robot_mode)')"/>
    </group>
    <group if="$(var competition_without_gpio)">
      <log message="ERROR: robot_mode=competition requires enable_gpio_ref=true"/>
    </group>
    <group if="$(var legacy_arguments)">
      <log message="ERROR: enable_autoreferee, require_teacher_permission, enable_twist_arbiter and enable_lab_shoot were replaced by robot_mode (lesson, practice or competition)"/>
    </group>
    <!-- Defer shutdown briefly so the operator-facing error is emitted first. -->
    <timer period="0.01">
      <shutdown reason="Invalid configuration: see the ERROR above (robot_mode, enable_gpio_ref)"/>
    </timer>
  </group>
  <!-- Profile YAML files are the single source of truth for GPIO pins and polarity. -->
  <let name="gpio_reader_config_file" value="$(find-pkg-share gpio_reader)/config/gpio_reader.practice.yaml" unless="$(var is_competition)"/>
  <let name="gpio_reader_config_file" value="$(find-pkg-share gpio_reader)/config/gpio_reader.competition.yaml" if="$(var is_competition)"/>
  <!-- All child processes stay disabled while the invalid branch reports and exits. -->
  <group unless="$(var invalid_configuration)">
    <include file="$(find-pkg-share questix_control_config)/launch/control_profile.launch.py" />
    <group if="$(var enable_shot)">
      <include file="$(find-pkg-share questix_launcher)/launch/shot_component.launch.xml">
        <arg name="controller_type" value="$(var controller_type)"/>
        <!-- QUESTiX LAB may operate the launcher in lesson mode only. -->
        <arg name="accept_lab_input" value="$(var is_lesson)"/>
      </include>
    </group>
    <group if="$(var enable_drive)">
      <include file="$(find-pkg-share questix_launcher)/launch/drive_component.launch.xml">
        <arg name="controller_type" value="$(var controller_type)"/>
        <!-- QUESTiX LAB shares the drive in lesson mode only; otherwise joy_controller drives
             /target_twist directly. -->
        <arg name="enable_twist_arbiter" value="$(var is_lesson)"/>
      </include>
    </group>
    <group if="$(var enable_lidar)">
      <include file="$(find-pkg-share ydlidar_ros2_driver)/launch/ydlidar_launch.py"/>
    </group>
    <group if="$(var enable_gpio_ref)">
      <include file="$(find-pkg-share gpio_reader)/launch/gpio_reader.launch.xml">
        <arg name="config_file" value="$(var gpio_reader_config_file)"/>
      </include>
    </group>
    <!-- operation_manager, in every configuration: the single owner of /emergency_stop (L1; GPIO5,
         or "released (no GPIO safety path)" without it: every actuating node and QUESTiX LAB stop
         while it is unheard, silent or active) and of /motion_permission (L2; practice needs no
         vote but it is still published, so every actuator keeps one rule: no /motion_permission,
         no motion), and RefereeMonitor (GPIO27) in competition. -->
    <include file="$(find-pkg-share operation_manager)/launch/operation_manager.launch.xml">
      <arg name="robot_mode" value="$(var robot_mode)"/>
      <arg name="enable_gpio_safety" value="$(var enable_gpio_ref)"/>
      <arg name="enable_referee" value="$(var is_competition)"/>
    </include>
    <!-- RViz Visualization -->
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" if="$(var enable_rviz)" args="-d $(find-pkg-share ydlidar_ros2_driver)/config/ydlidar.rviz">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>
</launch>
