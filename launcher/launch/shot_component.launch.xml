<launch>
  <!-- Launch Arguments -->
  <arg name="controller_type" default="dualshock" description="Controller type: dualshock, uart, or web" />
  <arg name="enable_gpio_ref" default="false" description="Use the gated joy topic supplied by the parent GPIO safety path" />
  <arg name="use_sim_time" default="false" description="Use simulation time" />
  <!-- QUESTiX LAB may operate the launcher (roller /roller/lab, tilt /shot/lab/tilt, fire
       /shot/lab/fire) only when this is true. questix_core sets it for practice runs only; it
       stays false with enable_autoreferee (competition). The node YAMLs keep false as default. -->
  <arg name="accept_lab_input" default="false" description="Let QUESTiX LAB operate the roller, tilt and fire (practice only; never with enable_autoreferee)" />

  <!-- Per-controller YAML profiles (auto-selected from controller_type).
       web_joy_driver publishes the same Switch2-native indices as uart_joy_driver,
       so controller_type=web reuses the *.uart.yaml profiles (no duplicate YAML).
       Override shot_config_file / esc_config_file to bypass selection. -->
  <let name="joy_profile" value="uart" if="$(equals '$(var controller_type)' 'web')" />
  <let name="joy_profile" value="$(var controller_type)" unless="$(equals '$(var controller_type)' 'web')" />
  <arg name="shot_config_file"
       default="$(find-pkg-share motor_control_app)/config/shot_config.$(var joy_profile).yaml"
       description="Shot component YAML (defaults to controller-specific profile)" />
  <arg name="esc_config_file"
       default="$(find-pkg-share esc_motor_control_cpp)/config/esc_motor_control_cpp.$(var joy_profile).yaml"
       description="ESC motor control YAML (defaults to controller-specific profile)" />

  <!-- joy topic selection based on enable_gpio_ref -->
  <let name="joy_topic_name" value="/joy_gated" if="$(var enable_gpio_ref)" />
  <let name="joy_topic_name" value="/joy" unless="$(var enable_gpio_ref)" />

  <!-- shot component launch -->
  <include file="$(find-pkg-share motor_control_app)/launch/shot_component.launch.py">
    <arg name="config_file" value="$(var shot_config_file)"/>
    <arg name="joy_topic" value="$(var joy_topic_name)"/>
    <arg name="accept_lab_input" value="$(var accept_lab_input)"/>
  </include>

  <!-- ESC Motor Control (C++) -->
  <include file="$(find-pkg-share esc_motor_control_cpp)/launch/esc_motor_control_cpp.launch.xml">
    <arg name="config_file" value="$(var esc_config_file)"/>
    <arg name="joy_topic" value="$(var joy_topic_name)"/>
    <arg name="accept_lab_input" value="$(var accept_lab_input)"/>
  </include>
</launch>
