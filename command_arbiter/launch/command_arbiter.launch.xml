<?xml version="1.0"?>
<!--
command_arbiter: the input selection of a lesson launch (questix_core robot_mode:=lesson).
The YAML (config/command_arbiter.yaml) is the single source of truth.
-->
<launch>
  <arg name="config_file"
       default="$(find-pkg-share command_arbiter)/config/command_arbiter.yaml"
       description="Path to the command_arbiter configuration YAML" />
  <arg name="enable_drive" default="true" description="Start the drive's arbiter (/target_twist)" />

  <node pkg="command_arbiter" exec="drive_arbiter_node" name="drive_arbiter" output="screen"
        if="$(var enable_drive)">
    <param from="$(var config_file)" />
  </node>
</launch>
