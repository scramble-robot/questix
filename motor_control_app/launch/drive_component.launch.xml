<?xml version="1.0"?>
<launch>
  <!-- Launch arguments -->
  <!-- 単体launch のハードウェア設定はノード宣言デフォルトを使用する。 -->
  <!-- キー割り当て・速度は questix_control_config の共通プロファイルを使用する。 -->
  <arg name="serial_port"
       default="/dev/ttyACM0"
       description="Serial port for motor communication" />
  <include file="$(find-pkg-share questix_control_config)/launch/control_profile.launch.py" />

  <!-- DriveComponent Node -->
  <node pkg="motor_control_app"
        exec="drive_component_node"
        name="drive_component"
        output="screen"
        respawn="true"
        respawn_delay="2.0">
    <param from="$(var control_config_file)" />
    <param name="serial_port" value="$(var serial_port)" />
  </node>
</launch>